# 数据库连接（注意：API 侧用 create_async_engine，须用 postgresql+asyncpg:// 驱动；
# 用同步 postgresql:// 会被静默吞掉并降级为内存存储）
QM_DB_URL=postgresql+asyncpg://qm:quantmind@timescaledb:5432/quantmind
QM_DB_PASSWORD=quantmind
QM_REDIS_URL=redis://redis:6379/0

# LLM（默认 mock，无 key 也能跑通全流程；填 key 后切真实 API）
QM_LLM_PROVIDER=mock
# QM_ANTHROPIC_KEY=
# QM_DEEPSEEK_KEY=
# QM_OPENAI_KEY=

# 回测/挖掘交易成本策略：auto=启用差异化成本表(默认) / off=零成本对照 / custom=自定义表
QM_BACKTEST_COST=auto

# API / Web
QM_API_URL=http://api:8000
QM_LOG_LEVEL=INFO

# Tavily 联网检索（方法论知识层·真实网络补充；缺 key 或不填则离线启发式兜底）
# TAVILY_API_KEY=
# 或 QM_TAVILY_API_KEY=   # 走 Pydantic Settings（QM_ 前缀）

# ---- 本地数据根目录（可选；非空时对应市场的本地 Parquet/CSV 源优先，高于实时源）----
# QM_LOCAL_STOCK_ROOT=   # A股数据根目录
# QM_LOCAL_HK_ROOT=      # 港股数据根目录
# QM_LOCAL_DATA_ROOT=    # 期货数据根目录
# QM_LOCAL_OPTION_ROOT=  # 期权数据根目录

# ---- 全市场（A股+港股）自动预热（可选；默认关闭）----
# 开启后调度器周期性把未缓存的 A股/港股标的分批拉入本地行情仓库（data_cache/）
# QM_MARKET_WARM_ENABLED=false     # 是否开启全市场自动预热
# QM_MARKET_WARM_BATCH=50          # 每趟预热标的上限（防止打爆数据源）
# QM_MARKET_WARM_MAX_SYMBOLS=5000  # 全市场标的池总上限
# QM_MARKET_WARM_INTERVAL_MINUTES=15  # 预热任务触发间隔（分钟）
# QM_MARKET_WARM_MARKETS=A,HK          # 自动预热覆盖的市场（A=A股, HK=港股；逗号分隔，缺省两者）

# 实时交易网关凭证（MVP 阶段留空，接 simnow/openctp 模拟盘时填写）
# CTP_BROKER_ID=
# CTP_USER_ID=
# CTP_PASSWORD=
# XTP_CLIENT_ID=
# XTP_USER_ID=
# XTP_PASSWORD=
# IB_HOST=
# IB_PORT=
# IB_CLIENT_ID=

# TqSdk 天勤量化（免费版 8000 根 K 线；期货数据下载首选数据源）
# 免费注册: https://www.shinnytech.com/register
QM_TQSDK_USER=
QM_TQSDK_PASS=
